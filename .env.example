# Copia este archivo como .env y complétalo. El .env tiene tu token: NUNCA lo subas a GitHub.

# ID de tu cuenta de Instagram (el de instagram_business_account, empieza con 1784...)
IG_USER_ID=tu_id_de_instagram

# Token extendido (~60 días) del Access Token Debugger
ACCESS_TOKEN=pega_aqui_tu_token_extendido

API_VERSION=v26.0

# Opcional: el App Secret (Configuración > Básica). Si lo pones, cada llamada va firmada con appsecret_proof.
APP_SECRET=

# SQL Server local (instancia por defecto) con autenticación de Windows
SQL_CONEXION="DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=AnalisisBarberiasPeluquerias;Trusted_Connection=yes;TrustServerCertificate=yes;"
